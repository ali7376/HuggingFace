# ===========================================================
# Add AT LEAST ONE API key. Every provider with a key will
# appear automatically in the app's sidebar.
# ===========================================================

# Hugging Face  ->  https://huggingface.co/settings/tokens
HF_TOKEN=

# Groq (free tier, very fast)  ->  https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini (free tier)  ->  https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---------------- Optional settings ----------------
# Which provider to open by default: huggingface | groq | gemini
DEFAULT_PROVIDER=

# Override the model names if you want (leave empty for defaults)
HF_MODEL=openai/gpt-oss-120b:cheapest
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.5-flash

# Branding
APP_NAME=Nexora
AVATAR_URL=
